---
import BaseLayout from '../layouts/BaseLayout.astro';
import VisitorBanner from '../components/VisitorBanner.astro';
import WritingCard from '../components/WritingCard.astro';
import LabCard from '../components/LabCard.astro';
import NoteCard from '../components/NoteCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { getCollection, render } from 'astro:content';
import { getReadingTime } from '../lib/readingTime';

const allWriting = (await getCollection('writing')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
const allLab = (await getCollection('lab')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
const allNotes = (await getCollection('notes')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const featured = allWriting[0];
const rest = allWriting.slice(1, 4);
const labItems = allLab.slice(0, 4);
const noteItems = allNotes.slice(0, 4);

// Get reading times
const featuredRendered = await render(featured);
const featuredReadingTime = getReadingTime(featured.body || '');
const restWithTime = await Promise.all(
  rest.map(async (entry) => ({
    ...entry,
    readingTime: getReadingTime(entry.body || ''),
  }))
);

// Render notes
const notesWithHtml = await Promise.all(
  noteItems.map(async (note) => {
    const rendered = await render(note);
    return { ...note, html: rendered.Content };
  })
);
---

<BaseLayout title="Anilkumar Panda — Seeking Zima">
  <div class="max-w-[1040px] mx-auto px-5 sm:px-8">
    <!-- Hero -->
    <section class="pt-6">
      <p class="text-[11px] uppercase text-ink-muted mb-3">Principal Data Scientist · Builder</p>
      <h1 class="font-serif text-[40px] sm:text-[56px] leading-[1.15] text-ink mb-2">
        Anil Kumar <em>Panda</em><span class="text-coral">.</span>
      </h1>
      <p class="font-serif italic text-ink-muted text-lg mb-4">Seeking Zima</p>
      <p class="text-ink-muted text-[17px] leading-relaxed max-w-[640px] mb-[30px]">
        Writing about ML, building products with AI, and the overlap
        between systems thinking and creative work. Based in Weesp, Netherlands.
      </p>
      <img
        src="/images/garden-ecosystem.jpg"
        width="1536"
        height="1024"
        alt="Ink and gouache illustration of emerald plants with coral network nodes around a turquoise pond, golden insects above, and interconnected roots below the soil."
        class="block w-full h-auto aspect-[3/2] object-cover rounded-[4px]"
        fetchpriority="high"
      />
      <div class="py-5">
        <p class="text-[11px] uppercase text-ink-muted">Specimen 01 / 03</p>
        <p class="font-serif text-2xl text-ink mt-1">Everything is connected</p>
        <p class="text-[13px] text-ink-muted">A quiet network of roots, visitors, and unexpected friendships.</p>
      </div>
      <div class="grid grid-cols-2 gap-2 sm:gap-4 mt-2">
        <figure>
          <img src="/images/garden-feedback.jpg" width="1536" height="1024" loading="lazy"
            alt="Illustration of a coral flower with pollinators, small plants, and dotted looping connections."
            class="block w-full h-auto aspect-[3/2] object-cover rounded-[4px] border border-border" />
          <figcaption class="text-xs text-ink-muted pt-2">02 · Feedback loops</figcaption>
        </figure>
        <figure>
          <img src="/images/garden-canal.jpg" width="1536" height="1024" loading="lazy"
            alt="Illustration of a turquoise canal and small buildings among reeds and flowers, with a golden dragonfly."
            class="block w-full h-auto aspect-[3/2] object-cover rounded-[4px] border border-border" />
          <figcaption class="text-xs text-ink-muted pt-2">03 · Canal life</figcaption>
        </figure>
      </div>
    </section>

    <!-- Visitor Banner -->
    <VisitorBanner />

    <!-- Writing -->
    <section class="mt-16">
      <SectionHeading title="Writing" href="/writing" />
      <WritingCard
        slug={featured.id}
        title={featured.data.title}
        description={featured.data.description}
        date={featured.data.date}
        artSeed={featured.data.artSeed}
        readingTime={featuredReadingTime}
        featured
      />
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5 mt-5">
        {restWithTime.map((entry) => (
          <WritingCard
            slug={entry.id}
            title={entry.data.title}
            description={entry.data.description}
            date={entry.data.date}
            artSeed={entry.data.artSeed}
            readingTime={entry.readingTime}
          />
        ))}
      </div>
    </section>

    <!-- Lab -->
    <section class="mt-20">
      <SectionHeading title="Lab" href="/lab" />
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        {labItems.map((project) => (
          <LabCard
            slug={project.id}
            title={project.data.title}
            description={project.data.description}
            status={project.data.status}
            tech={project.data.tech}
            artSeed={project.data.artSeed}
            demoUrl={project.data.demoUrl}
            githubUrl={project.data.githubUrl}
          />
        ))}
      </div>
    </section>

    <!-- Notes -->
    <section class="mt-20 mb-10">
      <SectionHeading title="Notes" href="/notes" />
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {notesWithHtml.map((note) => (
          <NoteCard date={note.data.date} body={note.body || ''} />
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

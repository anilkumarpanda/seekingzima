---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Now — Seeking Zima" description="What I'm working on, reading, and thinking about.">
  <div class="max-w-[860px] mx-auto px-6 py-14">
    <h1 class="font-serif text-[40px] tracking-[-0.8px] text-ink mb-2">Now</h1>
    <p class="text-ink-muted mb-10">What I'm working on, reading, and thinking about.</p>

    <div class="space-y-8">
      <div class="border border-border rounded-xl bg-card-bg p-6">
        <h2 class="font-serif text-[19px] tracking-[-0.3px] text-ink mb-3">Building</h2>
        <ul class="space-y-2 text-ink-muted">
          <li>MAGA Agent for Podlist — cross-domain connection discovery</li>
          <li>Exploring the transition from Data Scientist → Product Owner at ING</li>
        </ul>
      </div>

      <div class="border border-border rounded-xl bg-card-bg p-6">
        <h2 class="font-serif text-[19px] tracking-[-0.3px] text-ink mb-3">Reading</h2>
        <ul class="space-y-2 text-ink-muted">
          <li>Ergodicity and risk frameworks</li>
        </ul>
      </div>

      <div class="border border-border rounded-xl bg-card-bg p-6">
        <h2 class="font-serif text-[19px] tracking-[-0.3px] text-ink mb-3">Side Quests</h2>
        <ul class="space-y-2 text-ink-muted">
          <li>Flipping Apple Silicon Macs on Marktplaats</li>
        </ul>
      </div>
    </div>

    <p class="text-sm text-ink-faint mt-10">Last updated: March 2026</p>
  </div>
</BaseLayout>

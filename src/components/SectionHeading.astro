---
interface Props {
  title: string;
  href?: string;
}

const { title, href } = Astro.props;
---

<div class="flex items-center justify-between mb-6">
  <h2 class="font-serif text-[22px] text-ink">{title}</h2>
  {href && (
    <a href={href} class="text-sm text-ink-muted hover:text-accent transition-colors no-underline">
      View all &rarr;
    </a>
  )}
</div>

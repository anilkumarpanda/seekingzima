---
interface Props {
  id: string;
  width?: string;
  height?: string;
  class?: string;
  staticSeed?: number;
}

const { id, width = '100%', height = '100%', class: className = '', staticSeed } = Astro.props;
---

<canvas
  id={id}
  class={className}
  style={`width: ${width}; height: ${height};`}
  data-static-seed={staticSeed !== undefined ? String(staticSeed) : undefined}
></canvas>

<script>
  import { collectEntropy, deriveSeeds, renderArt, renderStaticArt } from '../lib/artEngine';

  function initCanvases() {
    const canvases = document.querySelectorAll<HTMLCanvasElement>('canvas[id]');
    const entropy = collectEntropy();
    const seeds = deriveSeeds(entropy, canvases.length);

    canvases.forEach((canvas, i) => {
      const staticSeed = canvas.dataset.staticSeed;
      if (staticSeed !== undefined) {
        renderStaticArt(canvas, parseInt(staticSeed, 10));
      } else {
        renderArt(canvas, seeds[i]);
      }
    });

    // Set fingerprint if element exists
    const fpEl = document.getElementById('visitor-fingerprint');
    if (fpEl && seeds.length > 0) {
      fpEl.textContent = 'fingerprint: ' + seeds[0].toString(16).padStart(8, '0');
    }
  }

  // Run on initial load and on Astro page transitions
  initCanvases();
  document.addEventListener('astro:after-swap', initCanvases);
</script>

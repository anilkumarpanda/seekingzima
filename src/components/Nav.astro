---
const links = [
  { href: '/writing', label: 'writing' },
  { href: '/lab', label: 'lab' },
  { href: '/notes', label: 'notes' },
  { href: '/now', label: 'now' },
  { href: '/about', label: 'about' },
];
---

<nav class="flex items-center justify-between py-6 px-5 sm:px-8 max-w-[1040px] mx-auto flex-wrap gap-y-2">
  <a href="/" class="font-serif text-[19px] text-ink no-underline hover:text-accent transition-colors">
    Anilkumar Panda
  </a>
  <div class="flex flex-wrap gap-x-5 gap-y-1 text-sm text-ink-muted">
    {links.map((link) => (
      <a
        href={link.href}
        class="no-underline hover:text-ink transition-colors"
      >
        {link.label}
      </a>
    ))}
  </div>
</nav>

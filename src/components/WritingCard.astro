---
import ArtCanvas from './ArtCanvas.astro';

interface Props {
  slug: string;
  title: string;
  description: string;
  date: Date;
  artSeed: number;
  readingTime: string;
  featured?: boolean;
}

const { slug, title, description, date, artSeed, readingTime, featured = false } = Astro.props;
const dateStr = date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

{featured ? (
  <a href={`/writing/${slug}`} class="block no-underline group">
    <div class="border border-border rounded-[14px] bg-card-bg overflow-hidden grid grid-cols-1 md:grid-cols-2 transition-transform duration-150 ease-out hover:-translate-y-0.5">
      <div class="aspect-[4/3] md:aspect-auto">
        <ArtCanvas id={`art-featured-${slug}`} staticSeed={artSeed} class="w-full h-full" />
      </div>
      <div class="p-6 flex flex-col justify-center">
        <div class="text-xs text-ink-muted mb-2">{dateStr} · {readingTime}</div>
        <h3 class="font-serif text-[19px] tracking-[-0.3px] text-ink group-hover:text-accent transition-colors mb-2">{title}</h3>
        <p class="text-sm text-ink-muted leading-relaxed">{description}</p>
      </div>
    </div>
  </a>
) : (
  <a href={`/writing/${slug}`} class="block no-underline group">
    <div class="border border-border rounded-[14px] bg-card-bg overflow-hidden transition-transform duration-150 ease-out hover:-translate-y-0.5">
      <div class="aspect-[16/9]">
        <ArtCanvas id={`art-${slug}`} staticSeed={artSeed} class="w-full h-full" />
      </div>
      <div class="p-5">
        <div class="text-xs text-ink-muted mb-1.5">{dateStr} · {readingTime}</div>
        <h3 class="font-serif text-[19px] tracking-[-0.3px] text-ink group-hover:text-accent transition-colors mb-1.5">{title}</h3>
        <p class="text-sm text-ink-muted leading-relaxed">{description}</p>
      </div>
    </div>
  </a>
)}

---
import BaseLayout from './BaseLayout.astro';
import ArtCanvas from '../components/ArtCanvas.astro';

interface Props {
  title: string;
  description: string;
  date: Date;
  readingTime?: string;
  artSeed: number;
  tags?: string[];
  tech?: string[];
  status?: string;
}

const { title, description, date, readingTime, artSeed, tags, tech, status } = Astro.props;
const dateStr = date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout title={`${title} — Seeking Zima`} description={description}>
  <article class="max-w-[860px] mx-auto px-6 py-10">
    <div class="rounded-xl overflow-hidden mb-8 aspect-[21/9]">
      <ArtCanvas id="art-hero" staticSeed={artSeed} class="w-full h-full" />
    </div>

    <header class="mb-10">
      <div class="flex items-center gap-3 text-sm text-ink-muted mb-3">
        <time>{dateStr}</time>
        {readingTime && (
          <>
            <span class="text-ink-faint">·</span>
            <span>{readingTime}</span>
          </>
        )}
        {status && (
          <>
            <span class="text-ink-faint">·</span>
            <span class={`text-[11px] font-medium px-2 py-0.5 rounded-full ${
              status === 'live' ? 'bg-green-light text-green' :
              status === 'building' ? 'bg-accent-light text-accent' :
              'bg-cream text-ink-muted'
            }`}>{status}</span>
          </>
        )}
      </div>
      <h1 class="font-serif text-[40px] leading-tight tracking-[-0.8px] text-ink mb-3">{title}</h1>
      <p class="text-ink-muted text-lg">{description}</p>
      {tags && tags.length > 0 && (
        <div class="flex flex-wrap gap-1.5 mt-4">
          {tags.map((tag) => (
            <span class="text-[11px] px-2 py-0.5 rounded-md bg-accent-light text-accent">
              {tag}
            </span>
          ))}
        </div>
      )}
      {tech && tech.length > 0 && (
        <div class="flex flex-wrap gap-1.5 mt-4">
          {tech.map((t) => (
            <span class="text-[11px] px-2 py-0.5 rounded-md bg-cream text-ink-muted border border-border">
              {t}
            </span>
          ))}
        </div>
      )}
    </header>

    <div class="prose">
      <slot />
    </div>
  </article>
</BaseLayout>
